<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>openframe-client</id>
    <!-- bumped only when tools/ changes; the asset endpoint always serves the tenant's current build -->
    <version>1.0.0</version>
    <title>OpenFrame Client (agent)</title>
    <authors>Flamingo</authors>
    <owners>Flamingo</owners>
    <projectUrl>https://openframe.ai</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Installs and enrolls the OpenFrame agent on a Windows machine.</summary>
    <description>
Downloads the OpenFrame client from the tenant's own server and enrolls the machine.
Link-only: the binary is fetched at install time from https://&lt;ServerUrl&gt;/v0/api/assets/download, never stored in the feed.

Required package parameters (pass with --params and keep them out of the log with --package-parameters-sensitive):
  /ServerUrl:&lt;tenant host&gt;   e.g. test-env.qa.openframe.build
  /InitialKey:&lt;enrollment key&gt;
  /OrgId:&lt;organisation id&gt;
  /UserId:&lt;user id&gt;
Optional:
  /MachineId:&lt;guid&gt;          identity sent as x-machine-id; a new GUID is generated when omitted
    </description>
    <tags>openframe agent rmm admin</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
